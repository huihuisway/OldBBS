{
  "name": "oldbbs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "Modern community core with old-school interfaces for OldBBS.CN",
  "files": [
    "src/",
    "views/",
    "public/",
    "scripts/",
    "deploy/",
    "test/",
    "README.md",
    ".env.example",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "node --watch -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "pnpm build && node --test dist/test/integration.test.js",
    "legacy:check": "node scripts/check-legacy.mjs",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:revert": "tsx src/database/migrate.ts revert",
    "db:seed": "tsx src/database/seed.ts",
    "storage:reconcile": "tsx scripts/storage-maintenance.ts",
    "views:check": "node scripts/check-views.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "connect-redis": "^9.0.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "file-type": "^16.5.4",
    "iconv-lite": "^0.6.3",
    "marked": "^15.0.12",
    "multer": "^2.0.2",
    "mysql2": "^3.14.4",
    "nunjucks": "^3.2.4",
    "redis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "sanitize-html": "^2.17.0",
    "ssh2": "^1.16.0",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/nunjucks": "^3.2.6",
    "@types/sanitize-html": "^2.16.0",
    "@types/ssh2": "^1.15.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
