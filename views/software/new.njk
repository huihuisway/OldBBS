{% extends "layouts/main.njk" %}{% block title %}添加软件 · OldBBS{% endblock %}{% block content %}<h1>提交软件资料</h1><p>普通用户提交后需审核；只提交有权分享的文件与链接。</p><form method="post" action="/software" class="form-panel"><input type="hidden" name="_csrf" value="{{ csrfToken }}">{% for field in [{name:'name',label:'软件名称',required:true},{name:'platform',label:'平台',required:true},{name:'version',label:'版本',required:true},{name:'developer',label:'开发者'},{name:'minimumOs',label:'最低系统'},{name:'architectures',label:'架构'},{name:'downloadUrl',label:'下载地址'},{name:'sha256',label:'SHA-256'}] %}<label>{{ field.label }}<input name="{{ field.name }}" {% if field.required %}required{% endif %}></label>{% endfor %}<label>介绍<textarea name="description" rows="8"></textarea></label><button type="submit">提交软件资料</button></form>{% endblock %}
