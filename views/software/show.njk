{% extends "layouts/main.njk" %}{% block title %}{{ software.name }} {{ software.version }} · OldBBS{% endblock %}{% block content %}<p><a href="/software">软件资料库</a></p><h1>{{ software.name }} {{ software.version }}</h1><p>{{ software.platform }} · {{ software.developer or "开发者未记录" }}</p><p>{{ software.description }}</p><dl class="spec-list"><dt>最低系统</dt><dd>{{ software.minimumOs or "未知" }}</dd><dt>架构</dt><dd>{{ software.architectures or "未知" }}</dd><dt>文件名</dt><dd>{{ software.fileName or "未提供" }}</dd><dt>大小</dt><dd>{{ software.fileSize or "未知" }}</dd><dt>SHA-256</dt><dd><code>{{ software.sha256 or "未提供" }}</code></dd></dl>{% if software.downloadUrl %}<p><a href="{{ software.downloadUrl }}" rel="nofollow">打开下载链接</a></p>{% endif %}<h2>相关讨论</h2><ul>{% for thread in threads %}<li><a href="/threads/{{ thread.id }}/{{ thread.slug }}">{{ thread.title }}</a></li>{% else %}<li>还没有相关讨论。</li>{% endfor %}</ul><h2>兼容报告</h2>{% if currentUser %}<p><a href="/compatibility-reports/new?softwareId={{ software.id }}">提交兼容报告</a></p>{% endif %}<ul>{% for report in reports %}<li>{{ report.device.name if report.device else "未知设备" }} · {{ report.systemVersion }} · {{ report.result }} — {{ report.notes }}</li>{% else %}<li>还没有兼容报告。</li>{% endfor %}</ul>{% endblock %}
