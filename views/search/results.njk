{% extends "layouts/main.njk" %}{% block title %}搜索 · OldBBS{% endblock %}{% block content %}<h1>搜索 OldBBS</h1><form method="get" action="/search" class="search-form"><label for="q">关键词</label><input id="q" name="q" value="{{ query }}" maxlength="80"><button type="submit">搜索</button></form>{% if query %}<h2>主题</h2><ul>{% for thread in threads %}<li><a href="/threads/{{ thread.id }}/{{ thread.slug }}">{{ thread.title }}</a> · {{ thread.board.name if thread.board else "" }}</li>{% else %}<li>没有匹配主题。</li>{% endfor %}</ul><h2>帖子</h2><ul>{% for post in posts %}<li><a href="/threads/{{ post.threadId }}/thread#post-{{ post.id }}">帖子 #{{ post.floor }}</a> · {{ post.content.slice(0, 180) }}</li>{% else %}<li>没有匹配帖子。</li>{% endfor %}</ul><h2>用户</h2><ul>{% for user in users %}<li><a href="/users/{{ user.username }}">{{ user.nickname }} (@{{ user.username }})</a></li>{% else %}<li>没有匹配用户。</li>{% endfor %}</ul><h2>设备</h2><ul>{% for device in devices %}<li><a href="/devices/{{ device.slug }}">{{ device.name }}</a> · {{ device.platform }}</li>{% else %}<li>没有匹配设备。</li>{% endfor %}</ul><h2>软件</h2><ul>{% for item in software %}<li><a href="/software/{{ item.slug }}">{{ item.name }} {{ item.version }}</a></li>{% else %}<li>没有匹配软件。</li>{% endfor %}</ul><nav class="pagination" aria-label="搜索分页">{% if page > 1 %}<a href="/search?q={{ queryParam }}&amp;page={{ page - 1 }}">上一页</a>{% endif %} 第 {{ page }} 页{% if counts.threads > page * pageSize or counts.posts > page * pageSize or counts.users > page * pageSize or counts.devices > page * pageSize or counts.software > page * pageSize %} <a href="/search?q={{ queryParam }}&amp;page={{ page + 1 }}">下一页</a>{% endif %}</nav>{% endif %}{% endblock %}
