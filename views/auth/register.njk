{% extends "layouts/main.njk" %}{% block title %}注册 · OldBBS{% endblock %}{% block content %}<h1>加入 OldBBS</h1>{% if registrationEnabled %}<form method="post" action="/register" class="form-panel"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><label for="username">用户名（3–32 位英文字母、数字、_ 或 -）</label><input id="username" name="username" minlength="3" maxlength="32" pattern="[A-Za-z0-9_-]+" autocomplete="username" required><label for="nickname">昵称</label><input id="nickname" name="nickname" maxlength="64"><label for="email">邮箱（选填）</label><input id="email" name="email" type="email" maxlength="190" autocomplete="email"><label for="password">密码（至少 12 位）</label><input id="password" name="password" type="password" minlength="12" maxlength="256" autocomplete="new-password" required><button type="submit">创建账号</button></form>{% else %}<p>目前暂停注册。</p>{% endif %}{% endblock %}
