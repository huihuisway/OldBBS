{% extends "layouts/main.njk" %}{% block title %}登录 · OldBBS{% endblock %}{% block content %}<h1>登录</h1><form method="post" action="/login" class="form-panel"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="next" value="{{ next or '/' }}"><label for="identity">用户名或邮箱</label><input id="identity" name="identity" autocomplete="username" required><label for="password">密码</label><input id="password" type="password" name="password" autocomplete="current-password" required><button type="submit">登录</button></form><p>还没有账号？<a href="/register">注册</a></p>{% endblock %}
