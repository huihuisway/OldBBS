{% extends "layouts/main.njk" %}{% block title %}#{{ tag.name }} · OldBBS{% endblock %}{% block content %}<h1>标签：{{ tag.name }}</h1><ul class="thread-list">{% for thread in threads %}<li><a href="/threads/{{ thread.id }}/{{ thread.slug }}">{{ thread.title }}</a> · {{ thread.author.nickname if thread.author else "用户" }}</li>{% else %}<li>该标签下还没有可见主题。</li>{% endfor %}</ul>{% endblock %}
