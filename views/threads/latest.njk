{% extends "layouts/main.njk" %}{% block title %}{{ title or "最新主题" }} · OldBBS{% endblock %}
{% block content %}<h1>{{ title or "最新主题" }}</h1><ul class="thread-list">{% for thread in threads %}<li>{% if thread.isPinned %}[置顶] {% endif %}<a href="/threads/{{ thread.id }}/{{ thread.slug }}">{{ thread.title }}</a><span class="muted">{{ thread.author.nickname if thread.author else "用户" }} · {{ thread.replyCount }} 回复 · {{ thread.board.name if thread.board else "" }}</span></li>{% else %}<li>没有主题。</li>{% endfor %}</ul>{% if pages %}<nav class="pagination" aria-label="分页">{% if page > 1 %}<a href="?page={{ page - 1 }}">上一页</a>{% endif %} 第 {{ page }} / {{ pages }} 页{% if page < pages %} <a href="?page={{ page + 1 }}">下一页</a>{% endif %}</nav>{% endif %}{% endblock %}
