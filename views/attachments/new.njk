{% extends "layouts/main.njk" %}{% block title %}上传附件 · OldBBS{% endblock %}{% block content %}<h1>上传附件</h1><p>最多 8 MB。接受常见图片、PDF、ZIP 和可执行安装包格式。上传文件会先隔离；完成安全扫描前不可下载。</p><form method="post" action="/attachments" enctype="multipart/form-data" class="form-panel"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><label>文件<input type="file" name="file" required></label><label>关联主题 ID（选填）<input name="threadId" inputmode="numeric"></label><button type="submit">上传文件</button></form>{% endblock %}
