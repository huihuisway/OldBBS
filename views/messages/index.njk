{% extends "layouts/main.njk" %}{% block title %}私信 · OldBBS{% endblock %}{% block content %}<h1>私信</h1><ul>{% for item in conversations %}<li><a href="/messages/{{ item.id }}">{{ item.otherUser.nickname if item.otherUser else "用户" }} (@{{ item.otherUser.username if item.otherUser else "?" }})</a> · {{ item.lastMessageAt.toISOString() if item.lastMessageAt else "" }}</li>{% else %}<li>暂无会话。可以从用户主页发送私信。</li>{% endfor %}</ul>{% endblock %}
