{% extends "layouts/main.njk" %}{% block title %}与 {{ otherUser.nickname if otherUser else "用户" }} 的私信 · OldBBS{% endblock %}{% block content %}<p><a href="/messages">← 私信列表</a></p><h1>{{ otherUser.nickname if otherUser else "私信" }}</h1><form method="post" action="/messages/{{ conversation.id }}/read"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit">标记对方消息为已读</button></form><ol class="message-list">{% for message in messages %}<li><p>{{ message.body }}</p><small>{{ message.createdAt.toISOString().replace('T', ' ').slice(0, 16) }} {% if message.senderId == currentUser.id %}· 我{% endif %}</small></li>{% else %}<li>暂无消息。</li>{% endfor %}</ol><form method="post" action="/messages" class="form-panel"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="to" value="{{ otherUser.username }}"><label>回复<textarea name="body" rows="5" required maxlength="10000"></textarea></label><button type="submit">发送</button></form><form method="post" action="/messages/{{ conversation.id }}/hide"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit">隐藏会话</button></form>{% endblock %}
