{% extends "layouts/main.njk" %}{% block title %}添加设备 · OldBBS{% endblock %}{% block content %}<h1>添加设备资料</h1><form method="post" action="/devices" class="form-panel"><input type="hidden" name="_csrf" value="{{ csrfToken }}">{% for field in [{name:'name',label:'设备名称',required:true},{name:'brand',label:'品牌',required:true},{name:'model',label:'型号',required:true},{name:'platform',label:'平台',required:true},{name:'releaseYear',label:'发布年份'},{name:'osVersions',label:'操作系统版本'},{name:'cpu',label:'处理器'},{name:'ram',label:'内存'},{name:'storage',label:'存储'},{name:'screen',label:'屏幕'}] %}<label>{{ field.label }}<input name="{{ field.name }}" {% if field.required %}required{% endif %}></label>{% endfor %}<label>介绍<textarea name="description" rows="8"></textarea></label><button type="submit">提交设备资料</button></form>{% endblock %}
