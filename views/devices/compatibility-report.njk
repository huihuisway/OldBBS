{% extends "layouts/main.njk" %}{% block title %}提交兼容报告 · OldBBS{% endblock %}{% block content %}<h1>提交兼容报告</h1><form method="post" action="/compatibility-reports" class="form-panel"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><label>设备<select name="deviceId" required>{% for device in devices %}<option value="{{ device.id }}" {% if selectedDevice == device.id %}selected{% endif %}>{{ device.name }}</option>{% endfor %}</select></label><label>软件<select name="softwareId" required>{% for item in software %}<option value="{{ item.id }}" {% if selectedSoftware == item.id %}selected{% endif %}>{{ item.name }} {{ item.version }}</option>{% endfor %}</select></label><label>系统版本<input name="systemVersion" maxlength="100" required></label><label>结果<select name="result"><option value="working">可运行</option><option value="partial">部分可用</option><option value="broken">无法运行</option><option value="unknown">未知</option></select></label><label>备注<textarea name="notes" rows="6" maxlength="3000"></textarea></label><button type="submit">提交报告</button></form>{% endblock %}
