{% extends "layouts/main.njk" %}{% block title %}{{ device.name }} · OldBBS{% endblock %}{% block content %}<p><a href="/devices">设备资料库</a></p><h1>{{ device.name }}</h1><p>{{ device.brand }} {{ device.model }} · {{ device.platform }}</p><p>{{ device.description }}</p><h2>基本参数</h2><dl class="spec-list"><dt>发布年份</dt><dd>{{ device.releaseYear or "未知" }}</dd><dt>系统</dt><dd>{{ device.osVersions or "未知" }}</dd><dt>处理器</dt><dd>{{ device.cpu or "未知" }}</dd><dt>内存</dt><dd>{{ device.ram or "未知" }}</dd><dt>存储</dt><dd>{{ device.storage or "未知" }}</dd><dt>屏幕</dt><dd>{{ device.screen or "未知" }}</dd></dl><h2>相关讨论</h2><ul>{% for thread in threads %}<li><a href="/threads/{{ thread.id }}/{{ thread.slug }}">{{ thread.title }}</a></li>{% else %}<li>还没有相关讨论。</li>{% endfor %}</ul><h2>相关软件</h2><ul>{% for item in software %}<li><a href="/software/{{ item.slug }}">{{ item.name }} {{ item.version }}</a></li>{% else %}<li>还没有关联软件。</li>{% endfor %}</ul><h2>兼容报告</h2>{% if currentUser %}<p><a href="/compatibility-reports/new?deviceId={{ device.id }}">提交兼容报告</a></p>{% endif %}<ul>{% for report in reports %}<li>{{ report.systemVersion }} · {{ report.result }} — {{ report.notes }}</li>{% else %}<li>还没有兼容报告。</li>{% endfor %}</ul>{% endblock %}
