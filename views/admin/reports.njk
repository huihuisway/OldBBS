{% extends "layouts/main.njk" %}{% block title %}举报队列 · OldBBS{% endblock %}{% block content %}<h1>举报队列</h1><table><thead><tr><th>状态</th><th>举报目标</th><th>举报人</th><th>原因</th><th>提交</th><th>处理</th></tr></thead><tbody>{% for report in reports %}<tr><td>{{ report.status }}</td><td>{{ report.targetType }} #{{ report.targetId }}</td><td>UID {{ report.reporterId }}</td><td>{{ report.reason }}</td><td>{{ report.createdAt.toISOString().slice(0, 16) }}</td><td>{% if report.status == 'open' %}<form method="post" action="/admin/moderate/report/{{ report.id }}/resolve" class="inline-form"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button>处理</button></form><form method="post" action="/admin/moderate/report/{{ report.id }}/dismiss" class="inline-form"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button>驳回</button></form>{% else %}UID {{ report.handledById or "—" }}{% endif %}</td></tr>{% else %}<tr><td colspan="6">没有举报。</td></tr>{% endfor %}</tbody></table>{% endblock %}
