{% extends "layouts/main.njk" %}{% block title %}管理后台 · OldBBS{% endblock %}{% block content %}<h1>OldBBS 管理台</h1><p>用户 {{ users }} · 主题 {{ threads }} · 帖子 {{ posts }} · 未处理举报 {{ pendingReports }}</p><nav><a href="/admin/boards">版块管理</a> · <a href="/admin/users">用户管理</a> · <a href="/admin/reports">举报队列</a> · <a href="/admin/devices">设备</a> · <a href="/admin/software">软件</a> · <a href="/admin/compatibility">兼容报告</a> · <a href="/admin/settings">站点设置</a> · <a href="/admin/audit">审计日志</a></nav><h2>举报队列</h2><table><thead><tr><th>举报人</th><th>目标</th><th>原因</th><th>提交时间</th><th>处理</th></tr></thead><tbody>{% for report in reports %}<tr><td>UID {{ report.reporterId }}</td><td>{{ report.targetType }} #{{ report.targetId }}</td><td>{{ report.reason }}</td><td>{{ report.createdAt.toISOString().slice(0, 16) }}</td><td><form method="post" action="/admin/moderate/report/{{ report.id }}/resolve"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit">标记处理</button></form></td></tr>{% else %}<tr><td colspan="5">目前没有未处理举报。</td></tr>{% endfor %}</tbody></table>{% endblock %}
