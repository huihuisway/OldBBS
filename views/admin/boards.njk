{% extends "layouts/main.njk" %}{% block title %}版块管理 · OldBBS{% endblock %}{% block content %}<h1>版块管理</h1><p>最低角色：公开、user、moderator 或 admin。隐藏版块只对版务人员和管理员开放。</p><table><thead><tr><th>版块</th><th>Slug</th><th>父版块</th><th>排序</th><th>最低角色</th><th>状态</th><th>保存</th></tr></thead><tbody>{% for board in boards %}{% set formId = 'board-form-' ~ board.id %}<tr><td><form id="{{ formId }}" method="post" action="/admin/boards/{{ board.id }}"><input type="hidden" name="_csrf" value="{{ csrfToken }}"></form><input form="{{ formId }}" name="name" value="{{ board.name }}"></td><td>{{ board.slug }}</td><td><input form="{{ formId }}" name="parentId" value="{{ board.parentId or '' }}"></td><td><input form="{{ formId }}" name="sortOrder" value="{{ board.sortOrder }}" size="4"></td><td><select form="{{ formId }}" name="minimumRole"><option value="">公开</option><option value="1" {% if board.minimumRole == 1 %}selected{% endif %}>user</option><option value="2" {% if board.minimumRole == 2 %}selected{% endif %}>moderator</option><option value="3" {% if board.minimumRole == 3 %}selected{% endif %}>admin</option></select></td><td><label><input form="{{ formId }}" type="checkbox" name="isHidden" {% if board.isHidden %}checked{% endif %}>隐藏</label><label><input form="{{ formId }}" type="checkbox" name="isReadOnly" {% if board.isReadOnly %}checked{% endif %}>只读</label></td><td><button form="{{ formId }}" type="submit">更新</button></td></tr>{% endfor %}</tbody></table><h2>创建版块</h2><form method="post" action="/admin/boards" class="form-panel"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><label>名称<input name="name" required></label><label>Slug（可留空自动生成）<input name="slug"></label><label>介绍<textarea name="description"></textarea></label><label>父版块 ID（根版块留空）<input name="parentId"></label><label>最低角色<select name="minimumRole"><option value="">公开</option><option value="1">user</option><option value="2">moderator</option><option value="3">admin</option></select></label><label>排序<input name="sortOrder" value="0"></label><button type="submit">创建</button></form>{% endblock %}
