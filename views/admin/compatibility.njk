{% extends "layouts/main.njk" %}{% block title %}兼容报告 · OldBBS{% endblock %}{% block content %}<h1>兼容报告审核</h1><table><thead><tr><th>状态</th><th>设备 ID</th><th>软件 ID</th><th>系统版本</th><th>结果</th><th>用户</th><th>备注</th><th>提交</th><th>操作</th></tr></thead><tbody>{% for report in reports %}<tr><td>{{ report.status }}</td><td>{{ report.deviceId }}</td><td>{{ report.softwareId }}</td><td>{{ report.systemVersion }}</td><td>{{ report.result }}</td><td>UID {{ report.authorId }}</td><td>{{ report.notes }}</td><td>{{ report.createdAt.toISOString().slice(0, 16) }}</td><td>{% if report.status == 'pending' %}<form method="post" action="/admin/moderate/compatibility/{{ report.id }}/approve"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button>通过</button></form><form method="post" action="/admin/moderate/compatibility/{{ report.id }}/reject"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button>拒绝</button></form>{% else %}<form method="post" action="/admin/moderate/compatibility/{{ report.id }}/delete"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button>隐藏</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="9">暂无报告。</td></tr>{% endfor %}</tbody></table>{% endblock %}
