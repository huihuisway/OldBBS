{% extends "layouts/main.njk" %}
{% block title %}用户管理 · OldBBS{% endblock %}
{% block content %}
<h1>用户管理</h1>
<form method="get" action="/admin/users" class="search-form">
  <label>用户名或昵称<input name="q" value="{{ query }}" maxlength="80"></label>
  <button type="submit">搜索</button>
</form>
<table>
  <thead><tr><th>UID</th><th>用户</th><th>角色</th><th>状态</th><th>帖子</th><th>加入时间</th><th>操作</th></tr></thead>
  <tbody>
  {% for user in users %}
    <tr>
      <td>{{ user.id }}</td>
      <td><a href="/users/{{ user.username }}">{{ user.nickname }} (@{{ user.username }})</a></td>
      <td><form method="post" action="/admin/users/{{ user.id }}/role"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="q" value="{{ query }}"><select name="role"><option value="user" {% if user.role == 'user' %}selected{% endif %}>user</option><option value="moderator" {% if user.role == 'moderator' %}selected{% endif %}>moderator</option><option value="admin" {% if user.role == 'admin' %}selected{% endif %}>admin</option></select><button type="submit">更新角色</button></form></td><td>{{ user.status }}</td><td>{{ user.postCount }}</td><td>{{ user.createdAt.toISOString().slice(0, 10) }}</td>
      <td>
        <form method="post" action="/admin/moderate/user/{{ user.id }}/warn"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input name="reason" placeholder="警告内容" required><button>发送警告</button></form>
        {% if user.status == 'banned' %}<form method="post" action="/admin/moderate/user/{{ user.id }}/unban"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button>解封</button></form>
        {% else %}<form method="post" action="/admin/moderate/user/{{ user.id }}/ban"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input name="reason" placeholder="封禁原因" required><button>封禁</button></form>{% endif %}
        <form method="post" action="/admin/moderate/user/{{ user.id }}/force_logout"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button>强制注销所有会话</button></form>
      </td>
    </tr>
  {% else %}<tr><td colspan="7">没有匹配用户。</td></tr>{% endfor %}
  </tbody>
</table>
{% endblock %}
