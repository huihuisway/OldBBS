{% extends "layouts/main.njk" %}{% block title %}站点设置 · OldBBS{% endblock %}{% block content %}<h1>站点设置</h1><form method="post" action="/admin/settings" class="form-panel"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><label>首页公告<textarea name="announcement" rows="6" maxlength="2000">{{ announcement }}</textarea></label><label>新用户注册<select name="registrationEnabled"><option value="environment" {% if registrationEnabled == 'environment' %}selected{% endif %}>使用 REGISTRATION_ENABLED 环境变量</option><option value="true" {% if registrationEnabled == 'true' %}selected{% endif %}>开放</option><option value="false" {% if registrationEnabled == 'false' %}selected{% endif %}>关闭</option></select></label><button type="submit">保存设置</button></form>{% endblock %}
