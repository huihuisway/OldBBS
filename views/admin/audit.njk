{% extends "layouts/main.njk" %}{% block title %}审计日志 · OldBBS{% endblock %}{% block content %}<h1>管理审计日志</h1><table><thead><tr><th>时间</th><th>管理员 UID</th><th>动作</th><th>目标</th><th>IP</th><th>数据</th></tr></thead><tbody>{% for log in logs %}<tr><td>{{ log.createdAt.toISOString() }}</td><td>{{ log.actorId or "系统" }}</td><td>{{ log.action }}</td><td>{{ log.targetType }} #{{ log.targetId or "—" }}</td><td>{{ log.ip or "—" }}</td><td><code>{{ log.metadata | dump }}</code></td></tr>{% else %}<tr><td colspan="6">暂无审计事件。</td></tr>{% endfor %}</tbody></table>{% endblock %}
