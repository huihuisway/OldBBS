{% extends "layouts/main.njk" %}{% block title %}Terminal Access Keys · OldBBS{% endblock %}{% block content %}<h1>Terminal Access Keys</h1><p>密钥只在创建时显示一次。Telnet 未加密，请使用专用密钥，不要输入 OldBBS 主密码。</p><form method="post" action="/terminal-keys" class="form-panel"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><label>名称<input name="name" maxlength="80" required></label><button type="submit">创建密钥</button></form><h2>现有密钥</h2><table><thead><tr><th>名称</th><th>创建时间</th><th>最近使用</th><th>最近 IP</th><th>操作</th></tr></thead><tbody>{% for key in keys %}<tr><td>{{ key.name }}</td><td>{{ key.createdAt.toISOString().slice(0, 10) }}</td><td>{{ key.lastUsedAt.toISOString() if key.lastUsedAt else "从未" }}</td><td>{{ key.lastIp or "—" }}</td><td><form method="post" action="/terminal-keys/{{ key.id }}/revoke"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit">吊销</button></form></td></tr>{% else %}<tr><td colspan="5">还没有密钥。</td></tr>{% endfor %}</tbody></table>{% endblock %}
