{% extends "layouts/main.njk" %}{% block title %}SSH 公钥 · OldBBS{% endblock %}{% block content %}<h1>SSH 公钥</h1><p>仅支持 ed25519 与 RSA。只粘贴公钥，绝不要上传私钥。</p><form method="post" action="/ssh-keys" class="form-panel"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><label>名称<input name="name" maxlength="80" required></label><label>公钥<textarea name="publicKey" rows="4" required></textarea></label><button type="submit">添加公钥</button></form><table><thead><tr><th>名称</th><th>SHA-256 指纹</th><th>创建</th><th>最近使用</th><th></th></tr></thead><tbody>{% for key in keys %}<tr><td>{{ key.name }}</td><td>{{ key.fingerprint }}</td><td>{{ key.createdAt.toISOString().slice(0, 10) }}</td><td>{{ key.lastUsedAt.toISOString() if key.lastUsedAt else "从未" }}</td><td><form method="post" action="/ssh-keys/{{ key.id }}/revoke"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit">吊销</button></form></td></tr>{% else %}<tr><td colspan="5">还没有公钥。</td></tr>{% endfor %}</tbody></table>{% endblock %}
