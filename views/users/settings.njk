{% extends "layouts/main.njk" %}{% block title %}账号设置 · OldBBS{% endblock %}{% block content %}<h1>账号设置</h1><ul><li><a href="/terminal-keys">Terminal Access Keys</a></li><li><a href="/ssh-keys">SSH 公钥</a></li></ul><form method="post" action="/settings" class="form-panel"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><label>昵称<input name="nickname" maxlength="64" value="{{ currentUser.nickname }}" required></label><label>签名<textarea name="signature" maxlength="500" rows="3">{{ currentUser.signature or "" }}</textarea></label><label>主题<select name="theme"><option value="classic" {% if currentUser.theme == 'classic' %}selected{% endif %}>Classic</option><option value="clean" {% if currentUser.theme == 'clean' %}selected{% endif %}>Clean</option></select></label><label><input type="checkbox" name="lowBandwidth" {% if currentUser.lowBandwidth %}checked{% endif %}>低带宽模式</label><button type="submit">保存设置</button></form><h2>修改密码</h2><form method="post" action="/settings/password" class="form-panel"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><label>当前密码<input type="password" name="currentPassword" autocomplete="current-password" required></label><label>新密码（至少 12 位）<input type="password" name="password" minlength="12" maxlength="256" autocomplete="new-password" required></label><button type="submit">更新密码</button></form>{% endblock %}
