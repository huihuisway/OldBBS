{% extends "layouts/main.njk" %}{% block title %}通知 · OldBBS{% endblock %}{% block content %}<h1>通知</h1><form method="post" action="/notifications/read"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit">全部标记为已读</button></form><ul class="thread-list">{% for item in items %}<li><strong>{{ item.title }}</strong> <span class="muted">{{ item.createdAt.toISOString().replace('T', ' ').slice(0, 16) }}</span> {% if not item.isRead %}<span>未读</span>{% endif %}<p>{{ item.body }}</p>{% if item.url %}<a href="{{ item.url }}">查看</a>{% endif %}</li>{% else %}<li>暂无通知。</li>{% endfor %}</ul>{% endblock %}
