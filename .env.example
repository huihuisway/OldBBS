NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
APP_URL=http://localhost:3000

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=oldbbs
DATABASE_PASSWORD=
DATABASE_NAME=oldbbs

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Set a unique value of at least 32 characters before starting the application.
SESSION_SECRET=
SESSION_TTL_SECONDS=1209600
COOKIE_SECURE=false
# Trust exactly the local Nginx proxy. Use false when connecting directly.
TRUST_PROXY=false
REGISTRATION_ENABLED=true

UPLOAD_DIR=./data/uploads
# Disabled by default. Use development only on a local non-production instance,
# or set clamav after installing a trusted ClamAV daemon/CLI on the host.
ATTACHMENT_SCANNER=disabled
CLAMAV_COMMAND=clamscan

SSH_ENABLED=true
SSH_HOST=0.0.0.0
SSH_PORT=2322
# Development default is ./data/ssh_host_ed25519; production default is
# /var/lib/oldbbs/ssh_host_ed25519. Override only to a persistent private path.
# SSH_HOST_KEY_PATH=
SSH_MAX_CHANNELS_PER_CONNECTION=4
SSH_MAX_SHELLS_PER_CONNECTION=1
SSH_SHELLS_PER_MINUTE=3
TELNET_ENABLED=true
TELNET_HOST=0.0.0.0
TELNET_PORT=2323

TERMINAL_MAX_CONNECTIONS=300
TERMINAL_MAX_CONNECTIONS_PER_IP=8
TERMINAL_IDLE_TIMEOUT_MS=1200000
TERMINAL_AUTH_TIMEOUT_MS=45000
TERMINAL_MAX_LIFETIME_MS=43200000
TERMINAL_COMMAND_RATE_LIMIT=60
TERMINAL_EXPENSIVE_COMMAND_RATE_LIMIT=12
